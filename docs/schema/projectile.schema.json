{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "arc_max": {
      "default": 0.0,
      "description": "How high it rises, in pixels (0: straight). Default depends on the shape.",
      "maximum": 500.0,
      "minimum": 0.0,
      "title": "Highest arc",
      "type": "number"
    },
    "arc_ratio": {
      "default": 0.08,
      "maximum": 5.0,
      "minimum": 0.0,
      "title": "Arc, share of distance",
      "type": "number"
    },
    "id": {
      "description": "Unique in its table; other files refer to it.",
      "title": "Id",
      "type": "string"
    },
    "max_seconds": {
      "default": 1.2,
      "maximum": 60.0,
      "minimum": 0.0,
      "title": "Longest flight (s)",
      "type": "number"
    },
    "min_seconds": {
      "default": 0.12,
      "maximum": 60.0,
      "minimum": 0.0,
      "title": "Shortest flight (s)",
      "type": "number"
    },
    "shape": {
      "default": "arrow",
      "description": "How it is drawn. Empty: the same as the id.",
      "enum": [
        "arrow",
        "bolt",
        "axe",
        "boulder",
        "fire",
        "magic",
        "coil"
      ],
      "title": "Shape",
      "type": "string"
    },
    "speed": {
      "default": 400.0,
      "description": "Pixels per second.",
      "maximum": 5000.0,
      "minimum": 1.0,
      "title": "Speed",
      "type": "number"
    }
  },
  "required": [
    "id"
  ],
  "title": "A projectile (projectiles.json)",
  "type": "object"
}
